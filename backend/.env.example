# Copy to .env and edit. NEVER commit .env.
ENVIRONMENT=development
# SQLite dev fallback (default). For PostgreSQL use:
#   DATABASE_URL=postgresql+psycopg2://setucare:CHANGE_ME@localhost:5432/setucare
DATABASE_URL=sqlite:///./setucare_dev.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
AUTO_CREATE_TABLES=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOW_PUBLIC_REGISTRATION=true

# Optional: seed the first administrator at startup (leave empty to skip)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Scheduler (overdue-referral escalation sweep)
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=15

# Deadline policy (hours from referral creation, by human-assigned urgency)
DEADLINE_HOURS_EMERGENCY=6
DEADLINE_HOURS_URGENT=24
DEADLINE_HOURS_SEMI_URGENT=72
DEADLINE_HOURS_ROUTINE=168
# Max hours between follow-up attempts (AI may shorten, never lengthen)
FOLLOWUP_INTERVAL_HOURS_EMERGENCY=1
FOLLOWUP_INTERVAL_HOURS_URGENT=6
FOLLOWUP_INTERVAL_HOURS_SEMI_URGENT=24
FOLLOWUP_INTERVAL_HOURS_ROUTINE=48
MAX_FOLLOWUP_ATTEMPTS=4

# AI agents: "mock" or "package.module:ClassName" implementing AIAgentProvider
AI_AGENT_PROVIDER=mock
AI_CONFIDENCE_THRESHOLD=0.6
